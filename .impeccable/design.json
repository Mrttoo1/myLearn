      "html": "<button class=\"ds-text\">编辑</button>",
      "css": ".ds-text{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:8px 4px;border:0;background:transparent;font-family:'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;font-size:13px;gap:8px;cursor:pointer;text-decoration:underline;text-decoration-color:transparent;text-underline-offset:4px;color:var(--accent,#2d614a)}.ds-text:hover:not(:disabled){text-decoration-color:currentColor}.ds-text:focus-visible{outline:3px solid #478764;outline-offset:4px;}.ds-text:disabled{cursor:not-allowed;opacity:.55}"
    },
    {
      "name": "/notes · 标题字段",
      "kind": "input",
      "refersTo": "field",
      "description": "视图内标准文本框；标签始终在字段上方。",
      "html": "<label class=\"ds-label\" for=\"ds-note-title\">学习主题 <span class=\"ds-required\">必填</span></label><input class=\"ds-input\" id=\"ds-note-title\" placeholder=\"例如：第一次理解数据库事务\" maxlength=\"100\" required>",
      "css": ".ds-label{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;font-family:'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;font-size:14px;font-weight:600;color:var(--ink,#243c32)}.ds-required{font-size:12px;font-weight:400;color:var(--muted,#5c685e)}.ds-input{display:block;width:100%;padding:13px 14px;color:var(--ink,#243c32);background:#fafbf6;border:1px solid #7f8b7c;border-radius:6px;font-family:'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;font-size:14px;line-height:1.7;accent-color:var(--accent,#2d614a);caret-color:var(--accent,#2d614a);}.ds-input::placeholder{color:#657060;opacity:1}.ds-input:focus-visible{outline:3px solid #478764;outline-offset:4px;}"
    },
    {
      "name": "/notes · 记录分页",
      "kind": "nav",
      "description": "从 NotesView.vue 内的分页导航提取，不是独立 Vue 组件；静态示例只演示外观。",
      "html": "<nav class=\"ds-pagination\" aria-label=\"记录分页\"><button class=\"ds-page-btn\" disabled>上一页</button><span class=\"ds-page-number\">第 1 / 2 页</span><button class=\"ds-page-btn\">下一页</button></nav>",
      "css": ".ds-pagination{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:28px}.ds-page-btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:11px 20px;border:1px solid transparent;border-radius:6px;font-family:'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;font-size:14px;font-weight:600;gap:8px;cursor:pointer;transition:background-color 160ms ease-out;padding:8px 14px;background:transparent;border-color:var(--line,#dcded4);color:var(--ink,#243c32)}.ds-page-btn:hover:not(:disabled){background:#e9ede3}.ds-page-btn:focus-visible{outline:3px solid #478764;outline-offset:4px;}.ds-page-btn:disabled{cursor:not-allowed;opacity:.55}.ds-page-number{font-family:'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;font-size:13px;color:var(--muted,#5c685e);font-variant-numeric:tabular-nums}"
    },
    {
      "name": "/notes · 分隔式记录",
      "kind": "custom",
      "description": "从视图内记录条目提取的外观预览；示例文字只用于预览，不是产品数据。",
      "html": "<article class=\"ds-note\"><div class=\"ds-meta\">时间</div><h3 class=\"ds-note-title\">记录标题</h3><p class=\"ds-note-content\">记录正文预览。</p><div class=\"ds-note-actions\"><button class=\"ds-note-edit\">编辑</button><button class=\"ds-note-delete\">删除</button></div></article>",
      "css": ".ds-note{padding:24px 0 16px;border-bottom:1px solid var(--line,#dcded4);overflow-wrap:anywhere;font-family:'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;color:var(--ink,#243c32)}.ds-note.ds-selected{background:#edf1e8;padding-inline:16px}.ds-meta{font-size:12px;color:var(--muted,#5c685e);margin-bottom:10px;font-variant-numeric:tabular-nums}.ds-note-title{margin:0;font-size:18px;line-height:1.6;font-weight:600}.ds-note-content{margin:8px 0 0;font-size:14px;line-height:1.9;color:#4a5d50;white-space:pre-wrap;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:4;overflow:hidden}.ds-note-actions{display:flex;gap:24px;margin-top:10px}.ds-note-edit,.ds-note-delete{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:8px 4px;border:0;background:transparent;font-family:'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;font-size:13px;gap:8px;cursor:pointer;text-decoration:underline;text-decoration-color:transparent;text-underline-offset:4px;color:var(--accent,#2d614a)}.ds-note-delete{color:var(--danger,#9b3c2e)}.ds-note-edit:hover:not(:disabled),.ds-note-delete:hover:not(:disabled){text-decoration-color:currentColor}.ds-note-edit:focus-visible,.ds-note-delete:focus-visible{outline:3px solid #478764;outline-offset:4px;}.ds-note-edit:disabled,.ds-note-delete:disabled{cursor:not-allowed;opacity:.55}"
    },
    {
      "name": "/notes · 编辑容器",
      "kind": "card",
      "refersTo": "editor",
      "description": "NotesView.vue 内的浅底编辑区域；本预览仅展示容器、标题与说明，没有新增 Vue 组件。",
      "html": "<aside class=\"ds-editor\"><div class=\"ds-editor-heading\"><h2 class=\"ds-editor-title\">写下新的收获</h2><span class=\"ds-editor-mark\" aria-hidden=\"true\"></span></div><p class=\"ds-editor-description\">用自己的话，记下你真正理解的部分。</p></aside>",
      "css": ".ds-editor{background:#eeeee5;padding:24px 28px 28px;border-radius:12px;font-family:'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;color:var(--ink,#243c32)}.ds-editor-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:44px}.ds-editor-title{margin:0;font-size:18px;font-weight:650}.ds-editor-mark{width:22px;height:3px;background:#9b6f44}.ds-editor-description{font-size:13px;line-height:1.8;color:var(--muted,#5c685e);margin:6px 0 26px}@media(max-width:1000px){.ds-editor{padding:20px}}@media(max-width:760px){.ds-editor-description{margin-bottom:20px}}"
    },
    {
      "name": "/notes · 错误提示",
      "kind": "custom",
      "refersTo": "error",
      "description": "表单与请求错误共用的提示外观；列表失败时附带重试按钮。",
      "html": "<div class=\"ds-error\" role=\"alert\"><p class=\"ds-error-copy\">操作失败，请重试</p><button class=\"ds-retry\">重新加载</button></div>",
      "css": ".ds-error{padding:14px 16px;background:#f7e9e0;color:#853525;font-family:'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;font-size:14px;line-height:1.8;margin:12px 0;border-radius:6px;overflow-wrap:anywhere}.ds-error-copy{margin:0}.ds-retry{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:8px 4px;border:0;background:transparent;font-family:'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;font-size:13px;gap:8px;cursor:pointer;text-decoration:underline;text-decoration-color:transparent;text-underline-offset:4px;color:#853525}.ds-retry:hover:not(:disabled){text-decoration-color:currentColor}.ds-retry:focus-visible{outline:3px solid #478764;outline-offset:4px;}.ds-retry:disabled{cursor:not-allowed;opacity:.55}"
    }
  ],
  "narrative": {
    "northStar": "纸上技术图解",
    "overview": "暖纸色、墨色线条和低饱和绿棕色构成阅读环境。用户指定 [MCP Explained](https://mcp-explained.com/) 的教学、视觉与技术插图方向；当前首页将交互流程、中文解释和真实项目源码并置。技术设备是 `TechnicalDevice.vue` 中原创编写的几何 SVG，保持可缩放线稿和少量明暗面。\n\n本记录从 `frontend/src/lesson.css`、`flow-interaction.css`、`styles.css`、`App.vue`、`views/LearnView.vue` 和现有图示、播放器、请求实验组件提取。首页是交互课程，原有纸上手记模式保留于辅助入口 `/notes`。前置 course/lesson 令牌描述课程；既有记录页令牌继续用于辅助页面，不替代课程配色。\n\n本轮交互记录以源码为依据；浏览器连接不可用，未执行新截图验收，旧截图不作为本轮证明。",
    "keyCharacteristics": [
      "暖纸色平面、墨色技术线稿与绿棕色状态强调。",
      "课程目录、完整稳定拓扑和源码检查并列；全部模块按运行环境紧凑分组，只随屏宽重排。",
      "GSAP 分别控制消息发送与阅读等待，历史查看独立于当前播放位置。",
      "示例演示与真实请求分别标明，学习记录使用真实数据。"
    ],
    "rules": [
      {
        "name": "The Flat Paper Rule",
        "body": "保持表面平整，以色阶与分隔线表达分组。",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** 保持暖纸色平面、墨线技术设备和清楚的中文讲解。",
      "**Do** 保留整节课的全部模块与稳定位置，用连线和高亮表达处理进度；发送与阅读等待保持一致，历史检查独立于播放位置。",
      "**Do** 标明示例演示、源码来源与真实请求结果，记录页显示真实数据。",
      "**Do** 保留字段标签、键盘焦点与异常文字；小屏保留完整内容与可展开目录。"
    ],
    "donts": [
      "**Don't** 将辅助学习记录作为课程首页的主视觉与布局依据。",
      "**Don't** 将原创 SVG 设备描述为生成图片或外部素材。",
      "**Don't** 用模拟进度填充真实记录空状态，或暗示播放控制能暂停真实后端事务。",
      "**Don't** 将平面分隔式内容改成重复悬浮卡片，或降低字段、辅助文字和焦点的可辨识度。"
    ]
  }
}
