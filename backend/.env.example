# 从项目根目录执行：Copy-Item backend/.env.example backend/.env
# 账号、密码、主机、端口、数据库名，与 compose.yaml 对应。
DATABASE_URL=postgresql+psycopg://learn:learn_dev_password@127.0.0.1:5432/learn

# 打开后可在后端终端观察 ORM 生成的 SQL，方便学习。
SQL_ECHO=false

# 测试必须使用独立数据库，库名必须以 _test 结尾。
TEST_DATABASE_URL=postgresql+psycopg://learn:learn_dev_password@127.0.0.1:5432/learn_test
